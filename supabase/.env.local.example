# ─────────────────────────────────────────────────────────────────────────────
# Supabase Edge Functions — Secretos requeridos
# Copia este archivo a .env.local y completa los valores.
# Nunca subas .env.local al repositorio (está en .gitignore).
#
# Para aplicarlos en producción:
#   supabase secrets set --env-file supabase/.env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Pagos Bre-B (Firux) ──────────────────────────────────────────────────────
# No son secretos de Edge Functions: los usa el servidor de la app (TanStack Start). En producción se guardan en
# Lovable Cloud → Secrets. Se crean en Firux → Ajustes → Conexiones API y se muestran una sola vez.
# firux_test_… para pruebas (permite POST /v1/charges/{id}/simulate_payment), firux_live_… en producción.
FIRUX_API_KEY=""
# Firma del aviso https://humanix.lat/api/public/firux/webhook (whsec_…)
FIRUX_WEBHOOK_SECRET=""

# ── WhatsApp Business Cloud API (Meta) ────────────────────────────────────────
# Token de acceso de larga duración (System User o Page Access Token)
# Obtener en: https://developers.facebook.com > Tu app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=""
# ID del número de teléfono de WhatsApp Business
# Obtener en: Meta Business Suite > WhatsApp > Números de teléfono
WHATSAPP_PHONE_NUMBER_ID=""
# Token de verificación personalizado (cualquier string aleatorio seguro)
# Se configura en: Meta App > Webhooks > Verificar y guardar
WHATSAPP_VERIFY_TOKEN=""
# App Secret de tu app de Meta (para verificar firmas X-Hub-Signature-256)
# Obtener en: Meta Developers > Tu app > Configuración > Básico > App Secret
WHATSAPP_APP_SECRET=""

# ── IA / Lovable AI Gateway ───────────────────────────────────────────────────
# Clave para el gateway de IA de Lovable (Gemini 2.5 Flash, Claude, GPT-4o)
# Usada por: whatsapp-webhook (AI replies), chat-copilot, humanix-assistant, y 15+ funciones más
LOVABLE_API_KEY=""

# ── Opcionales / Servicios externos ──────────────────────────────────────────
# RETHUS API (verificación de profesionales de salud — Colombia)
RETHUS_API_KEY=""
# Servicio de correo transaccional (si se usa send-campaign)
RESEND_API_KEY=""
