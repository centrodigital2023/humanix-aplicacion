# ─────────────────────────────────────────────────────────────────────────────
# Supabase Edge Functions — Secretos requeridos
# Copia este archivo a .env.local y completa los valores.
# Nunca subas .env.local al repositorio (está en .gitignore).
#
# Para aplicarlos en producción:
#   supabase secrets set --env-file supabase/.env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Pagos con Wompi ──────────────────────────────────────────────────────────
# No son secretos de Edge Functions: los usa el servidor de la app (TanStack Start). En producción se guardan en
# Lovable Cloud → Secrets. Se ven en el panel de Wompi → Desarrolladores (Sandbox: pub_test_/test_…; Producción: pub_prod_/prod_…).
# Cobros (Web Checkout):
WOMPI_PUBLIC_KEY=""
WOMPI_INTEGRITY_SECRET=""
# Firma de los eventos de cobros (URL: https://humanix.lat/api/public/wompi/webhook)
WOMPI_EVENTS_SECRET=""
# Opcional: a dónde vuelve la persona tras pagar (por defecto https://humanix.lat/pago/exito)
WOMPI_REDIRECT_URL=""
# Dispersión Bre-B a profesionales (API de Pagos a Terceros; Desarrolladores → Pagos a Terceros):
WOMPI_PAYOUTS_ENABLED="false"
WOMPI_PAYOUTS_ENV="sandbox"
WOMPI_PAYOUTS_API_KEY=""
WOMPI_PAYOUTS_USER_ID=""
# Cuenta de origen (GET /accounts de la API de Pagos a Terceros)
WOMPI_PAYOUTS_ACCOUNT_ID=""
# Firma de los eventos de Pagos a Terceros (URL: https://humanix.lat/api/public/wompi/payouts-webhook)
WOMPI_PAYOUTS_EVENTS_SECRET=""
# Secreto del despachador (/api/public/wompi/dispatch); el mismo valor va en hx_dispersion_config.secret
WOMPI_DISPATCH_SECRET=""

# ── WhatsApp Business Cloud API (Meta) ────────────────────────────────────────
# Token de acceso de larga duración (System User o Page Access Token)
# Obtener en: https://developers.facebook.com > Tu app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=""
# ID del número de teléfono de WhatsApp Business
# Obtener en: Meta Business Suite > WhatsApp > Números de teléfono
WHATSAPP_PHONE_NUMBER_ID=""
# Token de verificación personalizado (cualquier string aleatorio seguro)
# Se configura en: Meta App > Webhooks > Verificar y guardar
WHATSAPP_VERIFY_TOKEN=""
# App Secret de tu app de Meta (para verificar firmas X-Hub-Signature-256)
# Obtener en: Meta Developers > Tu app > Configuración > Básico > App Secret
WHATSAPP_APP_SECRET=""

# ── IA / Lovable AI Gateway ───────────────────────────────────────────────────
# Clave para el gateway de IA de Lovable (Gemini 2.5 Flash, Claude, GPT-4o)
# Usada por: whatsapp-webhook (AI replies), chat-copilot, humanix-assistant, y 15+ funciones más
LOVABLE_API_KEY=""

# ── Opcionales / Servicios externos ──────────────────────────────────────────
# RETHUS API (verificación de profesionales de salud — Colombia)
RETHUS_API_KEY=""
# Servicio de correo transaccional (si se usa send-campaign)
RESEND_API_KEY=""
